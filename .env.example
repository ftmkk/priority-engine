# ---- Postgres (consumed by both the db service and the app) ----
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=priority_engine
POSTGRES_USER=priority
POSTGRES_PASSWORD=priority_local_pw

# ---- app ----
PE_APP__LOG_LEVEL=INFO
PE_APP__ENV=docker

# Override any config.yaml value with PE_<SECTION>__<KEY> (double underscore = nesting).
# e.g. PE_TRAINING__ALGORITHM=logistic_regression

# host ports
API_PORT_HOST=8001
PANEL_PORT_HOST=8080
POSTGRES_PORT_HOST=5433
